SIPHON_HOST=siphon.example.com
SIPHON_DEFAULT_API_URL=https://api.example.com

API_URL=https://api.example.com/
CORS_URL=https://siphon.example.com
CORS_WILDCARD=0
API_AUTH_REQUIRED=1
API_KEY_URL=file:///run/secrets/siphon-keys.json

# Optional auth/session protection
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=
# JWT_SECRET=

# Optional source access / tuning
# COOKIE_PATH=/run/secrets/cookies.json
# YOUTUBE_GENERATE_PO_TOKENS=1
# Direct hosted tuning comes first. Only add YOUTUBE_PROXY_URL after the direct
# hosted queue still fails from the VPS.
# Leave blank to disable the session server entirely, or point at the internal
# service URL below to enable it.
# YOUTUBE_SESSION_SERVER=http://yt-session-generator:8080/
# YOUTUBE_SESSION_INNERTUBE_CLIENT=WEB
# YOUTUBE_HOSTED_VIDEO_CLIENTS=IOS,ANDROID,MWEB,TV
# YOUTUBE_HOSTED_AUDIO_CLIENTS=IOS,YTMUSIC_ANDROID,ANDROID,MWEB
# YOUTUBE_HOSTED_SESSION_CLIENTS=WEB,WEB_CREATOR
# YOUTUBE_PROXY_URL=http://user:pass@residential-proxy.example:8000
# Private YouTube failover to a second cobalt instance. Keep this deployer-only;
# the client will still stay on your Siphon domain.
# YOUTUBE_FALLBACK_API_URL=https://fallback.example
# YOUTUBE_FALLBACK_AUTH_HEADER=Api-Key your-fallback-key
# YOUTUBE_FALLBACK_TIMEOUT_MS=20000
# YT_SESSION_UPDATE_INTERVAL=1800
# YT_SESSION_RETRY_INTERVAL=60
# YT_SESSION_WORKER_HEAP_MB=3072
# Set these only if the token helper itself should use a dedicated proxy route.
# YT_SESSION_HTTP_PROXY=
# YT_SESSION_HTTPS_PROXY=
# YT_SESSION_NO_PROXY=
# CUSTOM_INNERTUBE_CLIENT=
# YOUTUBE_PLAYER_ID=
# ENABLE_DEPRECATED_YOUTUBE_HLS=

# Optional rate limiting / behavior
# RATELIMIT_WINDOW=60
# RATELIMIT_MAX=25
# SESSION_RATELIMIT_WINDOW=60
# SESSION_RATELIMIT_MAX=10
# TUNNEL_RATELIMIT_WINDOW=60
# TUNNEL_RATELIMIT_MAX=40
# DURATION_LIMIT=10800
# DISABLED_SERVICES=
# FORCE_LOCAL_PROCESSING=
