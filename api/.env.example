API_URL=http://localhost:9000
API_PORT=9000
API_AUTH_REQUIRED=1
CORS_WILDCARD=0
# If the web dev server runs with SIPHON_DEV_HTTPS=true, change this to https://localhost:5173.
CORS_URL=http://localhost:5173
API_KEY_URL=file:///absolute/path/to/your/Siphon/api/keys.sample.json
RATELIMIT_WINDOW=60
RATELIMIT_MAX=25

# local YouTube defaults:
# - keep built-in PO token generation enabled for local development.
# - leave YOUTUBE_SESSION_SERVER unset unless you are intentionally running
#   an external session-token service for hosted/advanced setups.
#YOUTUBE_GENERATE_PO_TOKENS=1
#YOUTUBE_SESSION_SERVER=http://host.docker.internal:4416
#YOUTUBE_SESSION_INNERTUBE_CLIENT=WEB
#YOUTUBE_HOSTED_VIDEO_CLIENTS=IOS,ANDROID,MWEB,TV
#YOUTUBE_HOSTED_AUDIO_CLIENTS=IOS,YTMUSIC_ANDROID,ANDROID,MWEB
#YOUTUBE_HOSTED_SESSION_CLIENTS=WEB,WEB_CREATOR
#YOUTUBE_PROXY_URL=http://user:pass@residential-proxy.example:8000
# Private secondary-instance failover for hosted YouTube. This keeps the client
# on your Siphon domain while retrying failed YouTube requests through another
# cobalt-compatible instance behind the scenes.
#YOUTUBE_FALLBACK_API_URL=https://fallback.example
#YOUTUBE_FALLBACK_AUTH_HEADER=Api-Key your-fallback-key
#YOUTUBE_FALLBACK_TIMEOUT_MS=20000
# Keep WEB_EMBEDDED opt-in only for explicit experiments.
#CUSTOM_INNERTUBE_CLIENT=
#YOUTUBE_PLAYER_ID=
